generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  LAWYER
  ASSISTANT
  CLIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum CaseStatus {
  INTAKE
  ACTIVE
  IN_HEARING
  SENTENCING
  APPEAL
  CLOSED
  ARCHIVED
}

enum CaseType {
  CIVIL
  CRIMINAL
  COMMERCIAL
  FAMILY
  LABOR
  ADMINISTRATIVE
  AMPARO
  TAX
  INTELLECTUAL_PROPERTY
  IMMIGRATION
  OTHER
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PartyRole {
  PLAINTIFF
  DEFENDANT
  WITNESS
  THIRD_PARTY
  CO_COUNSEL
  EXPERT_WITNESS
}

enum DocumentType {
  CONTRACT
  POWER_OF_ATTORNEY
  LAWSUIT
  RESPONSE
  EVIDENCE
  RULING
  APPEAL_BRIEF
  CORRESPONDENCE
  IDENTIFICATION
  OTHER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
  PARTIALLY_PAID
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  CASH
  CHECK
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum EventType {
  HEARING
  CLIENT_MEETING
  INTERNAL_MEETING
  LEGAL_DEADLINE
  DOCUMENT_DUE
  DEPOSITION
  MEDIATION
  OTHER
}

enum AttendeeStatus {
  CONFIRMED
  TENTATIVE
  DECLINED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONSULTATION_SCHEDULED
  CONVERTED
  DISCARDED
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  PHONE
  WALK_IN
  ADVERTISEMENT
  OTHER
}

enum NotificationType {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum SignatureStatus {
  PENDING
  SIGNED
  DECLINED
  EXPIRED
}

enum CaseAssignmentRole {
  LEAD_ATTORNEY
  CO_COUNSEL
  ASSISTANT
  SUPERVISOR
}

enum ClientType {
  INDIVIDUAL
  CORPORATION
}

// ============================================================
// AUTH & USERS
// ============================================================

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  passwordHash        String     @map("password_hash")
  role                UserRole   @default(CLIENT)
  status              UserStatus @default(PENDING_VERIFICATION)
  firstName           String     @map("first_name")
  lastName            String     @map("last_name")
  phone               String?
  avatarUrl           String?    @map("avatar_url")
  preferredLanguage   String     @default("es") @map("preferred_language")
  twoFactorSecret     String?    @map("two_factor_secret")
  twoFactorEnabled    Boolean    @default(false) @map("two_factor_enabled")
  lastLoginAt         DateTime?  @map("last_login_at")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")

  // Profiles by role
  lawyerProfile    LawyerProfile?
  clientProfile    ClientProfile?

  // Relations
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  caseAssignments     CaseAssignment[]
  caseNotes           CaseNote[]
  assignedTasks       CaseTask[]          @relation("TaskAssignee")
  timeEntries         TimeEntry[]
  createdExpenses     Expense[]           @relation("ExpenseCreator")
  sentMessages        ClientMessage[]     @relation("SentMessages")
  receivedMessages    ClientMessage[]     @relation("ReceivedMessages")
  uploadedDocuments   Document[]
  createdDocVersions  DocumentVersion[]   @relation("DocVersionCreator")
  createdEvents       Event[]
  eventAttendees      EventAttendee[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  assignedLeads       Lead[]
  conflictChecks      ConflictCheck[]     @relation("ConflictChecker")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model LawyerProfile {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  licenseNumber     String   @unique @map("license_number")
  specializations   String[]
  bio               String?
  hourlyRate        Decimal  @default(0) @map("hourly_rate") @db.Decimal(10, 2)
  yearsOfExperience Int?     @map("years_of_experience")
  barAssociation    String?  @map("bar_association")
  isPartner         Boolean  @default(false) @map("is_partner")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("lawyer_profiles")
}

model ClientProfile {
  id            String     @id @default(uuid())
  userId        String     @unique @map("user_id")
  clientType    ClientType @default(INDIVIDUAL) @map("client_type")
  rfc           String?
  companyName   String?    @map("company_name")
  fiscalAddress String?    @map("fiscal_address")
  referredBy    String?    @map("referred_by")
  notes         String?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cases    Case[]
  invoices Invoice[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("client_profiles")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  refreshToken String   @unique @map("refresh_token")
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  expiresAt    DateTime @map("expires_at")
  isRevoked    Boolean  @default(false) @map("is_revoked")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

// ============================================================
// CASE MANAGEMENT
// ============================================================

model Case {
  id              String       @id @default(uuid())
  caseNumber      String       @unique @map("case_number")
  title           String
  description     String?
  type            CaseType
  status          CaseStatus   @default(INTAKE)
  priority        CasePriority @default(MEDIUM)
  legalArea       String?      @map("legal_area")
  court           String?
  courtFileNumber String?      @map("court_file_number")
  startDate       DateTime     @default(now()) @map("start_date")
  closeDate       DateTime?    @map("close_date")

  clientProfileId String        @map("client_profile_id")
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id])

  assignments   CaseAssignment[]
  parties       CaseParty[]
  notes         CaseNote[]
  timeline      CaseTimeline[]
  tasks         CaseTask[]
  caseDocuments CaseDocument[]
  timeEntries   TimeEntry[]
  expenses      Expense[]
  invoices      Invoice[]
  events        Event[]
  messages      ClientMessage[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([caseNumber])
  @@index([status])
  @@index([type])
  @@index([clientProfileId])
  @@index([clientProfileId, status])
  @@index([deletedAt])
  @@index([startDate])
  @@map("cases")
}

model CaseAssignment {
  id         String             @id @default(uuid())
  caseId     String             @map("case_id")
  userId     String             @map("user_id")
  role       CaseAssignmentRole @default(LEAD_ATTORNEY)
  assignedAt DateTime           @default(now()) @map("assigned_at")
  removedAt  DateTime?          @map("removed_at")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([caseId, userId])
  @@index([userId])
  @@map("case_assignments")
}

model CaseParty {
  id      String    @id @default(uuid())
  caseId  String    @map("case_id")
  name    String
  role    PartyRole
  email   String?
  phone   String?
  address String?
  notes   String?

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([caseId])
  @@index([name])
  @@map("case_parties")
}

model CaseNote {
  id         String  @id @default(uuid())
  caseId     String  @map("case_id")
  authorId   String  @map("author_id")
  content    String
  isInternal Boolean @default(true) @map("is_internal")

  case   Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([caseId])
  @@index([authorId])
  @@map("case_notes")
}

model CaseTimeline {
  id          String  @id @default(uuid())
  caseId      String  @map("case_id")
  eventType   String  @map("event_type")
  title       String
  description String?
  isPublic    Boolean @default(false) @map("is_public")
  metadata    Json?

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([caseId])
  @@index([caseId, isPublic, createdAt])
  @@index([createdAt])
  @@map("case_timeline")
}

model CaseTask {
  id          String       @id @default(uuid())
  caseId      String       @map("case_id")
  assigneeId  String?      @map("assignee_id")
  title       String
  description String?
  dueDate     DateTime?    @map("due_date")
  isCompleted Boolean      @default(false) @map("is_completed")
  completedAt DateTime?    @map("completed_at")
  priority    CasePriority @default(MEDIUM)

  case     Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([caseId])
  @@index([assigneeId])
  @@index([dueDate])
  @@map("case_tasks")
}

// ============================================================
// DOCUMENTS
// ============================================================

model Document {
  id             String       @id @default(uuid())
  title          String
  type           DocumentType @default(OTHER)
  fileName       String       @map("file_name")
  fileUrl        String       @map("file_url")
  fileSize       Int          @map("file_size")
  mimeType       String       @map("mime_type")
  uploadedById   String       @map("uploaded_by_id")
  isConfidential Boolean      @default(false) @map("is_confidential")
  tags           String[]     @default([])
  currentVersion Int          @default(1) @map("current_version")

  uploadedBy    User                @relation(fields: [uploadedById], references: [id])
  versions      DocumentVersion[]
  signatures    DocumentSignature[]
  caseDocuments CaseDocument[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([type])
  @@index([uploadedById])
  @@index([deletedAt])
  @@map("documents")
}

model CaseDocument {
  id         String   @id @default(uuid())
  caseId     String   @map("case_id")
  documentId String   @map("document_id")
  addedAt    DateTime @default(now()) @map("added_at")

  case     Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id])

  @@unique([caseId, documentId])
  @@map("case_documents")
}

model DocumentVersion {
  id                String @id @default(uuid())
  documentId        String @map("document_id")
  versionNumber     Int    @map("version_number")
  fileUrl           String @map("file_url")
  fileSize          Int    @map("file_size")
  changeDescription String? @map("change_description")
  createdById       String @map("created_by_id")

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy User     @relation("DocVersionCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

model DocumentSignature {
  id                String          @id @default(uuid())
  documentId        String          @map("document_id")
  signerName        String          @map("signer_name")
  signerEmail       String          @map("signer_email")
  status            SignatureStatus @default(PENDING)
  signatureProvider String?         @map("signature_provider")
  externalId        String?         @map("external_id")
  signedAt          DateTime?       @map("signed_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([documentId])
  @@map("document_signatures")
}

// ============================================================
// BILLING
// ============================================================

model TimeEntry {
  id          String  @id @default(uuid())
  caseId      String  @map("case_id")
  lawyerId    String  @map("lawyer_id")
  description String
  hours       Decimal @db.Decimal(5, 2)
  rate        Decimal @db.Decimal(10, 2)
  isBillable  Boolean @default(true) @map("is_billable")
  isBilled    Boolean @default(false) @map("is_billed")
  date        DateTime @db.Date
  invoiceId   String? @map("invoice_id")

  case    Case     @relation(fields: [caseId], references: [id])
  lawyer  User     @relation(fields: [lawyerId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([caseId])
  @@index([lawyerId])
  @@index([date])
  @@index([invoiceId])
  @@map("time_entries")
}

model Expense {
  id          String  @id @default(uuid())
  caseId      String  @map("case_id")
  createdById String  @map("created_by_id")
  description String
  amount      Decimal @db.Decimal(10, 2)
  receiptUrl  String? @map("receipt_url")
  isBillable  Boolean @default(true) @map("is_billable")
  isBilled    Boolean @default(false) @map("is_billed")
  date        DateTime @db.Date
  invoiceId   String? @map("invoice_id")

  case      Case     @relation(fields: [caseId], references: [id])
  createdBy User     @relation("ExpenseCreator", fields: [createdById], references: [id])
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([caseId])
  @@index([deletedAt])
  @@map("expenses")
}

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique @map("invoice_number")
  caseId          String        @map("case_id")
  clientProfileId String        @map("client_profile_id")
  subtotal        Decimal       @db.Decimal(12, 2)
  taxRate         Decimal       @default(0.16) @map("tax_rate") @db.Decimal(4, 2)
  taxAmount       Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  status          InvoiceStatus @default(DRAFT)
  dueDate         DateTime      @map("due_date") @db.Date
  paidAt          DateTime?     @map("paid_at")
  cfdiUuid        String?       @map("cfdi_uuid")
  cfdiXmlUrl      String?       @map("cfdi_xml_url")
  pdfUrl          String?       @map("pdf_url")
  notes           String?

  case          Case          @relation(fields: [caseId], references: [id])
  clientProfile ClientProfile @relation(fields: [clientProfileId], references: [id])
  items         InvoiceItem[]
  payments      Payment[]
  timeEntries   TimeEntry[]
  expenses      Expense[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([caseId])
  @@index([clientProfileId])
  @@index([clientProfileId, status])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  description String
  quantity    Decimal @db.Decimal(8, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  amount      Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Payment {
  id            String        @id @default(uuid())
  invoiceId     String        @map("invoice_id")
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique @map("transaction_id")
  reference     String?
  notes         String?
  paidAt        DateTime      @default(now()) @map("paid_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([invoiceId])
  @@map("payments")
}

// ============================================================
// CALENDAR
// ============================================================

model Event {
  id          String    @id @default(uuid())
  title       String
  type        EventType @default(OTHER)
  description String?
  startDate   DateTime  @map("start_date")
  endDate     DateTime  @map("end_date")
  location    String?
  virtualUrl  String?   @map("virtual_url")
  isAllDay    Boolean   @default(false) @map("is_all_day")
  caseId      String?   @map("case_id")
  createdById String    @map("created_by_id")
  externalId  String?   @map("external_id")

  case      Case?           @relation(fields: [caseId], references: [id])
  createdBy User            @relation(fields: [createdById], references: [id])
  attendees EventAttendee[]
  reminders Reminder[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([caseId])
  @@index([startDate])
  @@index([createdById])
  @@map("events")
}

model EventAttendee {
  id      String         @id @default(uuid())
  eventId String         @map("event_id")
  userId  String         @map("user_id")
  status  AttendeeStatus @default(TENTATIVE)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@map("event_attendees")
}

model Reminder {
  id            String           @id @default(uuid())
  eventId       String           @map("event_id")
  type          NotificationType
  minutesBefore Int              @map("minutes_before")
  sentAt        DateTime?        @map("sent_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

// ============================================================
// CRM & INTAKE
// ============================================================

model Lead {
  id             String     @id @default(uuid())
  firstName      String     @map("first_name")
  lastName       String     @map("last_name")
  email          String
  phone          String?
  source         LeadSource @default(WEBSITE)
  areaOfInterest String?    @map("area_of_interest")
  message        String?
  score          Int        @default(0)
  status         LeadStatus @default(NEW)
  assignedToId   String?    @map("assigned_to_id")

  assignedTo     User?           @relation(fields: [assignedToId], references: [id])
  intakeForm     IntakeForm?
  conflictChecks ConflictCheck[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([email])
  @@index([assignedToId])
  @@map("leads")
}

model IntakeForm {
  id          String   @id @default(uuid())
  leadId      String   @unique @map("lead_id")
  responses   Json
  submittedAt DateTime @default(now()) @map("submitted_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("intake_forms")
}

model ConflictCheck {
  id          String   @id @default(uuid())
  leadId      String   @map("lead_id")
  checkedById String   @map("checked_by_id")
  result      Boolean
  details     String?
  checkedAt   DateTime @default(now()) @map("checked_at")

  lead      Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  checkedBy User @relation("ConflictChecker", fields: [checkedById], references: [id])

  @@map("conflict_checks")
}

// ============================================================
// COMMUNICATION
// ============================================================

model ClientMessage {
  id          String    @id @default(uuid())
  caseId      String    @map("case_id")
  senderId    String    @map("sender_id")
  receiverId  String    @map("receiver_id")
  content     String
  attachments Json?     @default("[]")
  readAt      DateTime? @map("read_at")

  case     Case @relation(fields: [caseId], references: [id])
  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([caseId])
  @@index([caseId, createdAt])
  @@index([senderId])
  @@index([receiverId])
  @@index([receiverId, readAt])
  @@index([createdAt])
  @@map("client_messages")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id     String           @id @default(uuid())
  userId String           @map("user_id")
  type   NotificationType
  title  String
  body   String
  data   Json?
  readAt DateTime?        @map("read_at")
  sentAt DateTime?        @map("sent_at")

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, readAt])
  @@index([readAt])
  @@map("notifications")
}

// ============================================================
// AUDIT
// ============================================================

model AuditLog {
  id         String  @id @default(uuid())
  userId     String? @map("user_id")
  action     String
  entityType String  @map("entity_type")
  entityId   String? @map("entity_id")
  oldValue   Json?   @map("old_value")
  newValue   Json?   @map("new_value")
  ipAddress  String? @map("ip_address")
  userAgent  String? @map("user_agent")

  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// WEBHOOKS
// ============================================================

model WebhookEndpoint {
  id          String   @id @default(uuid())
  url         String
  secret      String
  events      String[]
  isActive    Boolean  @default(true) @map("is_active")
  description String?
  createdById String   @map("created_by_id")

  deliveries WebhookDelivery[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([isActive])
  @@index([deletedAt])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id         String  @id @default(uuid())
  endpointId String  @map("endpoint_id")
  event      String
  payload    Json
  statusCode Int?    @map("status_code")
  response   String?
  attempts   Int     @default(0)
  success    Boolean @default(false)
  lastError  String? @map("last_error")

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([endpointId, createdAt])
  @@index([event])
  @@index([createdAt])
  @@map("webhook_deliveries")
}
