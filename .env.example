# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/corporate_lawyers?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_REFRESH_EXPIRATION=7d

# 2FA
TWO_FACTOR_APP_NAME=CorporateLawyers

# Storage (S3/MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=corporate-lawyers
STORAGE_REGION=us-east-1

# Mail (SendGrid)
MAIL_FROM=noreply@corporatelawyers.com
SENDGRID_API_KEY=

# Throttle
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:4200

# Bcrypt
BCRYPT_ROUNDS=12
